# =============================================================================
# VoteChain Contracts — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values for your target environment.
# NEVER commit .env with real secrets.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Network selection
# Accepted values: local | testnet | mainnet
# -----------------------------------------------------------------------------
NETWORK=local

# -----------------------------------------------------------------------------
# Stellar RPC endpoint for the selected network
# local   : http://localhost:8000
# testnet : https://soroban-testnet.stellar.org
# mainnet : https://soroban-mainnet.stellar.org  (or your own RPC node)
# -----------------------------------------------------------------------------
STELLAR_RPC_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Network passphrase — must match the target network exactly
# local   : Standalone Network ; February 2017
# testnet : Test SDF Network ; September 2015
# mainnet : Public Global Stellar Network ; September 2015
# -----------------------------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# -----------------------------------------------------------------------------
# Deployer / admin keypair
# STELLAR_SECRET_KEY : the secret key (S...) of the account that will deploy
#                      and administer the contracts.
# STELLAR_PUBLIC_KEY : the corresponding public key (G...).
# -----------------------------------------------------------------------------
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# Deployed contract addresses (populated after running scripts/deploy.sh)
# Leave as placeholders until deployment is complete.
# -----------------------------------------------------------------------------
GOVERNANCE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TOKEN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------------------------------------------------------------------
# Governance parameters (used by deploy scripts)
# MIN_PROPOSAL_BALANCE : minimum token balance required to create a proposal (stroops)
# PROPOSAL_COOLDOWN    : seconds a proposer must wait between proposals
# -----------------------------------------------------------------------------
MIN_PROPOSAL_BALANCE=0
PROPOSAL_COOLDOWN=0

# =============================================================================
# Frontend Configuration
# =============================================================================

# Stellar network for explorer links (frontend)
# Accepted values: testnet | public
# Determines which Stellar network to link to (stellar.expert)
VITE_STELLAR_NETWORK=testnet

# Custom Stellar Explorer domain (optional)
# Defaults to stellar.expert if not set
# Use custom domain for private/local Stellar networks
# Example: VITE_STELLAR_EXPLORER_DOMAIN=steexp.com
# VITE_STELLAR_EXPLORER_DOMAIN=stellar.expert

# -----------------------------------------------------------------------------
# Indexer database  ⚠️  SENSITIVE — contains credentials
# DATABASE_URL           : postgres://USER@HOST:5432/votechain
#                          Do NOT embed the password here in production: env
#                          vars are visible via /proc/<pid>/environ and may be
#                          captured by process listings or crash reports.
# DATABASE_PASSWORD_FILE : path to a file (e.g. a Docker/K8s secret) holding
#                          only the password. It is injected at startup and the
#                          indexer scrubs both variables from its environment.
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://votechain@localhost:5432/votechain
DATABASE_PASSWORD_FILE=/run/secrets/db_password

# -----------------------------------------------------------------------------
# Indexer — Horizon URL  ⚠️  SSRF PREVENTION
# HORIZON_URL              : Base URL of the Stellar Horizon (or Soroban RPC)
#                            endpoint the indexer polls for contract events.
#
#                            MUST be an https:// URL in production.
#                            The hostname MUST appear in ALLOWED_HORIZON_DOMAINS.
#                            Literal private/loopback IP addresses are always
#                            blocked (RFC 1918, RFC 4193, link-local, loopback)
#                            to prevent Server-Side Request Forgery (SSRF).
#
#                            ⚠️  DNS-resolved IPs are NOT validated at startup.
#                            Use a trusted network boundary (firewall/VPC egress
#                            rules) to restrict outbound traffic to known hosts.
#
# Examples:
#   testnet : https://horizon-testnet.stellar.org
#   mainnet : https://horizon.stellar.org
# -----------------------------------------------------------------------------
HORIZON_URL=https://horizon-testnet.stellar.org

# -----------------------------------------------------------------------------
# Indexer — Horizon domain allowlist
# ALLOWED_HORIZON_DOMAINS : Comma-separated list of hostnames the indexer is
#                           permitted to connect to.  The HORIZON_URL hostname
#                           must appear in this list or startup fails.
#
#                           Default (when unset):
#                             horizon-testnet.stellar.org,horizon.stellar.org
#
#                           Override for private/custom Horizon nodes:
#                             ALLOWED_HORIZON_DOMAINS=my-horizon.internal.corp
#
#                           Multiple values:
#                             ALLOWED_HORIZON_DOMAINS=horizon.stellar.org,horizon-testnet.stellar.org,my-node.example.com
# -----------------------------------------------------------------------------
# ALLOWED_HORIZON_DOMAINS=horizon-testnet.stellar.org,horizon.stellar.org
